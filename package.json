{
  "name": "graphite-orbit",
  "version": "1.2.0",
  "private": true,
  "description": "跨平台 SSH 与本地终端工作台 · Graphite Orbit",
  "author": "Graphite Orbit contributors",
  "homepage": "https://github.com/1823616178/termius-app#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/1823616178/termius-app.git"
  },
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "yarn check:classes && yarn check:arch && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "yarn build && playwright test workbench.spec.ts --output=test-results/desktop",
    "test:packaged": "yarn pack:dir && playwright test packaged.spec.ts --output=test-results/packaged",
    "format": "prettier --write src scripts tests *.ts *.mts",
    "format:check": "prettier --check src scripts tests *.ts *.mts",
    "report:dependencies": "node scripts/dependency-report.mjs",
    "check:classes": "node scripts/check-classes.mjs",
    "check:arch": "node scripts/check-arch.mjs",
    "native:rebuild": "node scripts/rebuild-native.mjs",
    "postinstall": "install-electron && yarn run native:rebuild",
    "pack:dir": "yarn build && electron-builder --win --x64 --dir",
    "pack:win": "yarn build && electron-builder --win nsis --x64",
    "pack:win:publish": "yarn build && electron-builder --win nsis --x64 --publish always",
    "pack:linux:dir": "yarn build && electron-builder --linux --x64 --dir",
    "pack:linux": "yarn build && electron-builder --linux AppImage deb --x64",
    "release:checksums": "node scripts/release-checksums.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.1.1",
    "node-pty": "1.1.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/lib-storage": "^3",
    "@devolutions/iron-remote-desktop": "0.11.0",
    "@devolutions/iron-remote-desktop-rdp": "0.7.0",
    "@electron/rebuild": "4.2.1",
    "@lucide/vue": "1.70.0",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.1",
    "@types/ssh2": "1.15.6",
    "@types/three": "0.187.0",
    "@types/ws": "^8",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/compiler-sfc": "3.5.45",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "basic-ftp": "^6",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "ftp-srv": "4.6.3",
    "prettier": "3.6.2",
    "sass": "1.108.2",
    "three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14",
    "webdav": "^5",
    "webdav-server": "2.6.3",
    "ws": "^8",
    "zod": "4.6.7"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    },
    "cpu-features": {
      "built": true
    },
    "electron": {
      "built": true
    },
    "node-pty": {
      "built": true
    },
    "ssh2": {
      "built": true
    }
  }
}
